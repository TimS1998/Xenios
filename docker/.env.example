# Vorlage für docker compose (in diesem Ordner):  cp .env.example .env
# (.env wird nicht eingecheckt)

# Zeitzone des Containers (Zeitplan/Wecker; lässt sich auch in der App unter Server ändern)
TZ=Europe/Berlin

# HTTPS-Port auf dem Server. Mit IP davor nur auf dieser Netzwerkkarte, z. B. 192.168.178.32:8443
# (wichtig unter Linux: Docker-Ports umgehen ufw)
XENIOS_HTTPS_PORT=8443

# Fertiges Image aus GitHub Packages statt selbst bauen:
# XENIOS_IMAGE=ghcr.io/tims1998/xenios:latest
# XENIOS_PULL=always

# Cloudflare-Tunnel: Token aus dem Dashboard (Networks → Tunnels → dein Tunnel → Docker)
# TUNNEL_TOKEN=
# COMPOSE_PROFILES=tunnel

# Optional: Schlüssel für die verschlüsselten Werte in config.json (z. B. `openssl rand -base64 32`).
# Leer = der Server legt /data/secret.key an. Nicht nachträglich ändern, sonst lassen sich die Werte nicht mehr lesen.
XENIOS_SECRET_KEY=
