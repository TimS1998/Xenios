<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Netzwerksuche: eigenes WLAN-Netz (Adresse und Präfix) ermitteln -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 17+: Zugriff auf Geräte im Heimnetz (Maschine, Mühle, lokaler Server) – wird zur Laufzeit erfragt -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <!-- Widgets alle 5 s aktualisieren: exakte Wecker (nur bei eingeschaltetem Bildschirm, weckt nicht). Bis Android 13
         automatisch erteilt, ab Android 14 einmal in den Einstellungen („Wecker und Erinnerungen“) zu erlauben – die App
         weist darauf hin. Ohne Erlaubnis aktualisieren die Widgets langsamer. (Kein USE_EXACT_ALARM: das erlaubt Google
         Play nur Wecker- und Kalender-Apps.) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- App-Update: Rechte und Receiver nur in der Variante mit Updater (src/updater/AndroidManifest.xml) -->

    <!-- Uhr-Apps sichtbar machen: Name der App, die den nächsten Wecker gestellt hat -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SHOW_ALARMS" />
        </intent>
    </queries>

    <application
        android:name=".XeniaApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Xenia">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <meta-data android:name="android.app.shortcuts" android:resource="@xml/shortcuts" />
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!-- Unsichtbar: führt einen App-Shortcut (Ein/Aus/Eco) aus und schließt sich wieder. -->
        <activity
            android:name=".ActionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Xenia.Invisible" />

        <!-- Reihenfolge wie in der Widget-Auswahl gewünscht: Ein/Aus, Ein ohne Dampf/Aus, Espressomaschine, Schalter, dann wie die Home-Kacheln -->
        <receiver
            android:name=".PowerWidget"
            android:exported="false"
            android:label="@string/widget_power">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_power_info" />
        </receiver>

        <receiver
            android:name=".PowerNoSteamWidget"
            android:exported="false"
            android:label="@string/widget_powerns">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_powerns_info" />
        </receiver>

        <receiver
            android:name=".ModeWidget"
            android:exported="false"
            android:label="@string/widget_mode">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_mode_info" />
        </receiver>

        <receiver
            android:name=".LargeWidget"
            android:exported="false"
            android:label="@string/widget_large">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_large_info" />
        </receiver>

        <receiver
            android:name=".SwitchWidget"
            android:exported="false"
            android:label="@string/widget_switch">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_switch_info" />
        </receiver>

        <receiver
            android:name=".GaugesWidget"
            android:exported="false"
            android:label="@string/widget_gauges">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_gauges_info" />
        </receiver>

        <receiver
            android:name=".HistoryWidget"
            android:exported="false"
            android:label="@string/widget_history">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_history_info" />
        </receiver>

        <receiver
            android:name=".LastShotWidget"
            android:exported="false"
            android:label="@string/widget_lastshot">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_lastshot_info" />
        </receiver>

        <receiver
            android:name=".ShotsWidget"
            android:exported="false"
            android:label="@string/widget_shots">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_shots_info" />
        </receiver>

        <receiver
            android:name=".ShotsLargeWidget"
            android:exported="false"
            android:label="@string/widget_shotslarge">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_shotslarge_info" />
        </receiver>

        <receiver
            android:name=".TargetsWidget"
            android:exported="false"
            android:label="@string/widget_targets">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_targets_info" />
        </receiver>

        <receiver
            android:name=".CareWidget"
            android:exported="false"
            android:label="@string/widget_care">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider" android:resource="@xml/widget_care_info" />
        </receiver>

        <!-- Erlaubnis für exakte Wecker erteilt: Widgets sofort wieder im 5-Sekunden-Takt -->
        <receiver
            android:name=".ExactAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Nächsten Wecker an den Server melden (Wecker-Automatik) -->
        <receiver
            android:name=".AlarmChangedReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".PowerTileService"
            android:exported="true"
            android:icon="@drawable/ic_power"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>
    </application>
</manifest>
