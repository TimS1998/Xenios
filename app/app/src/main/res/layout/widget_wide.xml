<?xml version="1.0" encoding="utf-8"?>
<!-- Schmales Widget (4×1): Status und Temperatur links, Ein/Eco/Aus rechts. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_off"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="8dp"
    android:paddingTop="6dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:id="@+id/header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="Kaffeemaschine"
            android:textColor="@color/widget_text"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/details"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="–"
            android:textColor="@color/widget_text_dim"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/btn_on"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:text="Ein"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_eco"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:text="Eco"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_off"
        android:layout_width="44dp"
        android:layout_height="36dp"
        android:layout_marginStart="4dp"
        android:background="@drawable/widget_btn"
        android:gravity="center"
        android:text="Aus"
        android:textColor="@color/widget_text"
        android:textSize="13sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/refresh"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:contentDescription="Aktualisieren"
        android:padding="5dp"
        android:src="@drawable/ic_refresh" />
</LinearLayout>
